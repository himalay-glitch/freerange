				<div class="card-list-item blog-post-card">

					<a class="card-list-item-link" href="/blog/the-free-ranger-podcast-season-1-episode-1-air">
						
							<img class="card-bg" src="/hubfs/london-fog-sepia.jpeg" alt="">
						

						<div class="collapsed-info">
							

							
								<h2 class="title">The Free Ranger Podcast—Season 1, Episode 1: Air (ft. Kate Winkler Dawson)</h2>
							

							<p class="category ">
									
									
									The Free Ranger Podcast, 
									
									Podcast
									
									
							</p>
						</div>
					</a>

					<div class="card-list-item-expanded-info expanded-info" style="opacity: 0;">

						

						<p>
							
								
									<a href="/blog?tags=the-free-ranger-podcast" rel="tag">The Free Ranger Podcast</a>, 
								
