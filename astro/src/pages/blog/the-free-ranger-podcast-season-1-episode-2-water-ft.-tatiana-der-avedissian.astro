					<div class="card-list-item-expanded-info expanded-info" style="opacity: 0;">

						

						<p>
							
								
									<a href="/blog?tags=podcast" rel="tag">Podcast</a>
								
							
						</p>

						<div class="description">
							<div>
								
									<a href="/blog/the-free-ranger-podcast-season-2-episode-3-the-philosophy-of-marketing-ethics-ft.-heather-salazar">
										<h2 class="title">The Free Ranger Podcast—Season 2, Episode 3:&nbsp;The Philosophy of Marketing Ethics (ft. Heather Salazar)</h2>
									</a>
								
								<p class="summary"></p>
							</div>

							<a href="/blog/the-free-ranger-podcast-season-2-episode-3-the-philosophy-of-marketing-ethics-ft.-heather-salazar">View Post</a>
								
